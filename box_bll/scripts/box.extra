#!/system/bin/sh
# 外部引擎管理, 由 box.service 引用
# 引擎由 ${box_path}/extra/engine 中的 engine=<名称> 行决定, 支持 aether / usque / warpscout
# 值为 none / clash / mihomo 或文件缺失时不启用外部引擎
# 每个引擎独立目录: 二进制 / 配置文件 / cmdline 均在其中
# 下载优先使用模块自带的 ${box_path}/bin/curl (build.sh 打包), 其次系统 curl / wget / busybox wget

extra_path="${box_path}/extra"
extra_engine_file="${extra_path}/engine"
extra_default_port="11211"
extra_mirror="https://gh-proxy.com/"
extra_api="https://api.github.com/repos"

extra_log() {
    log "$1" "[extra] $2"
}

# 判断引擎是否已安装: 安装脚本会把 extra 目录下的文件统一成 0644, 不能只看执行位;
# 文件存在但缺执行位时顺手补上, 避免界面误报"未安装"
extra_bin_installed() {
    [ -f "${extra_bin}" ] || return 1
    [ -x "${extra_bin}" ] || chmod 0755 "${extra_bin}" 2>/dev/null
    return 0
}

# 把引擎自身输出最近 n 行直接写入当前输出 (worker 的 stdout 即运行日志)
extra_log_tail() {
    local n="$1" file="${2:-${extra_out_log}}" line
    [ -f "${file}" ] || return 0
    tail -n "${n}" "${file}" 2>/dev/null | while IFS= read -r line; do
        printf '    | %s\n' "${line}"
    done
}

# 跳过空行与 # 注释, 取第一个有效行; 兼容旧的裸引擎名格式
extra_engine() {
    local line name
    [ -f "${extra_engine_file}" ] || return 1
    while IFS= read -r line || [ -n "${line}" ]; do
        line=$(printf '%s' "${line}" | tr -d '\r' | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')
        case "${line}" in
            ''|'#'*) continue ;;
        esac
        name=${line#engine=}
        case "${name}" in
            aether|usque|warpscout) printf '%s' "${name}"; return 0 ;;
        esac
        return 1
    done < "${extra_engine_file}"
    return 1
}

extra_repo() {
    case "$1" in
        aether) printf '%s' "CluvexStudio/Aether" ;;
        usque) printf '%s' "Diniboy1123/usque" ;;
        warpscout) printf '%s' "vernette/warpscout" ;;
    esac
}

extra_asset_pattern() {
    case "$1" in
        aether) printf '%s' 'aether-android-arm64\.tar\.gz$' ;;
        usque) printf '%s' 'usque_.*_android_arm64\.zip$' ;;
        warpscout) printf '%s' 'warpscout_.*_android_arm64\.tar\.gz$' ;;
    esac
}

extra_paths() {
    extra_engine_name="$1"
    extra_dir="${extra_path}/${extra_engine_name}"
    extra_bin="${extra_dir}/${extra_engine_name}"
    extra_cmdline="${extra_dir}/cmdline"
    extra_pid_file="${run_path}/extra_${extra_engine_name}.pid"
    extra_worker_pid_file="${run_path}/extra_${extra_engine_name}.worker.pid"
    extra_state_file="${run_path}/extra_${extra_engine_name}.state"
    extra_log_dir="${extra_dir}/log"
    extra_run_log="${extra_log_dir}/${extra_engine_name}_$(date +%Y%m%d).log"
    extra_out_log="${extra_log_dir}/${extra_engine_name}_out_$(date +%Y%m%d).log"
}

# 先直连 GitHub, 失败再走镜像
# Android 无系统 curl, 模块随包提供 ${box_path}/bin/curl (build.sh 下载)
extra_download() {
    local url="$1" out="$2" c
    rm -f "${out}"
    if [ -x "${box_path}/bin/curl" ]; then
        "${box_path}/bin/curl" -fsSL --connect-timeout 8 --max-time 600 "${url}" -o "${out}" 2>/dev/null && return 0
    elif c=$(command -v curl 2>/dev/null) && [ -n "${c}" ]; then
        "${c}" -fsSL --connect-timeout 8 --max-time 600 "${url}" -o "${out}" 2>/dev/null && return 0
    elif c=$(command -v wget 2>/dev/null) && [ -n "${c}" ]; then
        "${c}" -q -O "${out}" "${url}" 2>/dev/null && return 0
    elif [ -x "${box_path}/bin/busybox" ]; then
        "${box_path}/bin/busybox" wget -q -O "${out}" "${url}" 2>/dev/null && return 0
    else
        return 1
    fi
    rm -f "${out}"
    return 1
}

# 先直连 GitHub, 失败再走镜像
extra_fetch() {
    extra_download "$1" "$2" && return 0
    extra_download "${extra_mirror}$1" "$2" && return 0
    return 1
}

extra_extract() {
    local file="$1" dest="$2"
    case "${file}" in
        *.zip)
            if command -v unzip >/dev/null 2>&1; then
                unzip -oq -d "${dest}" "${file}" 2>/dev/null || unzip -o -d "${dest}" "${file}" 2>/dev/null
            elif [ -x "${box_path}/bin/busybox" ]; then
                ( cd "${dest}" && "${box_path}/bin/busybox" unzip -o "${file}" ) 2>/dev/null
            else
                return 1
            fi
            ;;
        *)
            if command -v tar >/dev/null 2>&1; then
                tar -C "${dest}" -xzf "${file}" 2>/dev/null
            elif [ -x "${box_path}/bin/busybox" ]; then
                "${box_path}/bin/busybox" tar -C "${dest}" -xzf "${file}" 2>/dev/null
            else
                return 1
            fi
            ;;
    esac
}

extra_wait_network() {
    local i=0
    while [ "${i}" -lt 30 ]; do
        if "${SYS_IP:-ip}" route 2>/dev/null | grep -q "default"; then
            return 0
        fi
        i=$((i + 1))
        sleep 2
    done
    return 1
}

# 本地安装版本 (即发布 tag), 无记录时返回失败
extra_local_version() {
    local file="${extra_dir}/version" v
    [ -f "${file}" ] || return 1
    v=$(sed -n '1p' "${file}" 2>/dev/null | tr -d ' \t\r')
    [ -n "${v}" ] || return 1
    printf '%s' "${v}"
}

extra_remote_tag() {
    local engine="$1" repo tmp
    repo=$(extra_repo "${engine}")
    tmp="${extra_dir}/.tag.$$"
    if ! extra_fetch "${extra_api}/${repo}/releases/latest" "${tmp}"; then
        rm -f "${tmp}"
        return 1
    fi
    sed -n 's/.*"tag_name":[[:space:]]*"\([^"]*\)".*/\1/p' "${tmp}" | head -n1
    rm -f "${tmp}"
}

extra_install_bin() {
    local engine="$1" dir="$2" repo json url tag tmp api_tmp
    repo=$(extra_repo "${engine}")
    api_tmp="${dir}/.download.$$.json"
    extra_log Info "正在获取 ${engine} 最新版本..."
    extra_fetch "${extra_api}/${repo}/releases/latest" "${api_tmp}" || {
        extra_log Error "获取 ${repo} 最新版本失败 (GitHub 直连与镜像均不可用)"
        rm -f "${api_tmp}"
        return 1
    }
    json=$(cat "${api_tmp}" 2>/dev/null)
    rm -f "${api_tmp}"
    tag=$(printf '%s' "${json}" | sed -n 's/.*"tag_name":[[:space:]]*"\([^"]*\)".*/\1/p' | head -n1)
    url=$(printf '%s' "${json}" | grep -o '"browser_download_url":[[:space:]]*"[^"]*"' \
        | sed -n 's/.*"\(https[^"]*\)".*/\1/p' \
        | grep -E "$(extra_asset_pattern "${engine}")" | head -n1)
    if [ -z "${url}" ]; then
        extra_log Error "未找到 android_arm64 发布包 (${repo} ${tag})"
        return 1
    fi

    case "${url}" in
        *.zip) tmp="${dir}/.download.$$.zip" ;;
        *) tmp="${dir}/.download.$$.tar.gz" ;;
    esac
    extra_log Info "下载 ${engine} ${tag}: ${url}"
    extra_fetch "${url}" "${tmp}" || {
        extra_log Error "下载失败: ${url}"
        rm -f "${tmp}"
        return 1
    }

    if ! extra_extract "${tmp}" "${dir}"; then
        extra_log Error "解压失败: ${tmp}"
        rm -f "${tmp}"
        return 1
    fi
    rm -f "${tmp}"

    [ -f "${dir}/${engine}" ] || {
        extra_log Error "发布包中未找到 ${engine} 二进制"
        return 1
    }
    chmod 0755 "${dir}/${engine}"
    printf '%s\n' "${tag}" > "${dir}/version"
    extra_log Info "${engine} ${tag} 安装完成"
}

extra_init_conf() {
    local engine="$1" dir="$2"
    case "${engine}" in
        aether)
            # 身份文件 aether.toml / aether-masque.toml 由首次启动自动生成
            extra_log Info "Aether 首次启动会自动注册设备并生成 aether.toml"
            return 0
            ;;
        usque)
            [ -f "${dir}/config.json" ] && return 0
            extra_log Info "未检测到 usque 配置, 正在执行 register..."
            ( cd "${dir}" && ./usque register -c config.json -a ) || {
                extra_log Error "usque register 失败 (需要联网, 可能被限流, 请稍后重启服务重试)"
                return 1
            }
            [ -f "${dir}/config.json" ] || {
                extra_log Error "usque register 未生成 config.json"
                return 1
            }
            extra_log Info "usque 配置已生成: ${dir}/config.json"
            ;;
        warpscout)
            [ -f "${dir}/warpscout-account.json" ] && return 0
            extra_log Info "未检测到 warpscout 账户, 正在执行 register..."
            ( cd "${dir}" && ./warpscout register ) || {
                extra_log Error "warpscout register 失败 (需要联网)"
                return 1
            }
            [ -f "${dir}/warpscout-account.json" ] || {
                extra_log Error "warpscout register 未生成 warpscout-account.json"
                return 1
            }
            extra_log Info "warpscout 账户已生成: ${dir}/warpscout-account.json"
            ;;
    esac
}

extra_default_cmdline() {
    local engine="$1"
    case "${engine}" in
        aether)
            printf '%s' "--masque --bind 127.0.0.1:${extra_default_port} -4 --noize gfw --no-quick-reconnect --reconnect-secs 2 --peer 162.159.199.2:4500"
            ;;
        usque)
            printf '%s' "socks -b 127.0.0.1 -p ${extra_default_port} -c config.json -s www.microsoft.com --connect-port 500"
            ;;
        warpscout)
            # -e 是必填项且无默认值; 其余用程序默认: 账户 warpscout-account.json、监听 127.0.0.1
            printf '%s' "socks -e 162.159.198.2:8095 -p masque -P ${extra_default_port}"
            ;;
    esac
}

# 读取 cmdline 第一行有效参数, 忽略空行与 # 注释
extra_read_cmdline() {
    local file="$1" line
    [ -f "${file}" ] || return 1
    while IFS= read -r line || [ -n "${line}" ]; do
        line=$(printf '%s' "${line}" | tr -d '\r')
        case "${line}" in
            ''|'#'*) continue ;;
        esac
        printf '%s' "${line}"
        return 0
    done < "${file}"
    return 1
}

# 引擎是当前 shell 的子进程, 未被 wait 前 kill -0 对僵尸进程仍为真, 需看 /proc 状态
extra_alive() {
    local pid="$1" state
    case "${pid}" in
        ''|*[!0-9]*) return 1 ;;
    esac
    state=$(sed 's/^[^)]*) //' "/proc/${pid}/stat" 2>/dev/null | cut -d' ' -f1)
    [ -n "${state}" ] && [ "${state}" != "Z" ]
}

# 进程退出后 PID 会被系统复用, 只凭 kill -0 会把不相干进程当成自己的;
# 命令行里带着预期特征才算命中, /proc 不可读时按存在处理
extra_pid_matches() {
    local pid="$1" pattern="$2" cmd
    [ -r "/proc/${pid}/cmdline" ] || return 0
    cmd=$(tr '\0' ' ' < "/proc/${pid}/cmdline" 2>/dev/null)
    [ -n "${cmd}" ] || return 0
    case "${cmd}" in
        *"${pattern}"*) return 0 ;;
    esac
    return 1
}

# probe 每 5 秒并发读取 pid 文件, 直接覆盖写会让它读到空内容;
# 先写临时文件再 mv 原子替换, 读者只会看到完整的旧值或新值
extra_write_pid() {
    local file="$1" pid="$2"
    printf '%s\n' "${pid}" > "${file}.tmp" 2>/dev/null && mv -f "${file}.tmp" "${file}" 2>/dev/null
}

# 状态文件内容: "initializing" 或 "running <pid>", 由 worker 在阶段切换时改写
extra_state_stage() {
    sed -n '1p' "${extra_state_file}" 2>/dev/null | cut -d' ' -f1 | tr -d ' \t\r'
}

extra_state_pid() {
    sed -n 's/^running[[:space:]][[:space:]]*\([0-9][0-9]*\).*/\1/p' "${extra_state_file}" 2>/dev/null | head -n 1
}

extra_clash_alive() {
    local d
    [ -n "${bin_name}" ] || return 0
    if command -v pidof >/dev/null 2>&1; then
        pidof -s "${bin_name}" >/dev/null 2>&1
        return $?
    fi
    for d in /proc/[0-9]*; do
        [ "$(cat "${d}/comm" 2>/dev/null)" = "${bin_name}" ] && return 0
    done
    return 1
}

# 用户在 APP 里直接结束 clash 进程时不会经过 box.service stop,
# 因此由引擎侧盯住 clash 存活; 连续 3 次 (约 9 秒) 检测不到才动作, 避免重启间隙误杀
extra_clash_guard() {
    local pid="$1" miss=0
    while extra_alive "${pid}"; do
        if extra_clash_alive; then
            miss=0
        else
            miss=$((miss + 1))
            extra_log Warn "未检测到 ${bin_name} 进程 (${miss}/3)"
            if [ "${miss}" -ge 3 ]; then
                extra_log Warn "检测到 ${bin_name} 已停止, 同步停止 ${extra_engine_name} (PID: ${pid})"
                kill "${pid}" 2>/dev/null
                sleep 2
                extra_alive "${pid}" && kill -9 "${pid}" 2>/dev/null
                return 0
            fi
        fi
        sleep 3
    done
}

# 读取 "--flag value" / "--flag=value" 形式的参数值
extra_arg_value() {
    local flag="$1" value=""
    shift
    while [ $# -gt 0 ]; do
        case "$1" in
            "${flag}")
                if [ $# -ge 2 ]; then
                    value="$2"
                    shift 2
                    continue
                fi
                ;;
            "${flag}="*)
                value="${1#*=}"
                ;;
        esac
        shift
    done
    printf '%s' "${value}"
}

# config.yaml 把「3.额外地址」声明为 type: file 的 provider, mihomo 启动时会直接读取该文件,
# 内容不是合法 provider (缺 proxies: 列表) 时该 provider 加载失败, 外部引擎节点不会出现在代理组里.
# 因此这里保证文件存在且合法, 引擎启用时再把 SOCKS 监听端口同步进去.
extra_sync_proxy_port() {
    local engine="$1" args="$2" raw="" port="" file old new default_port
    default_port="${extra_default_port:-11211}"

    case "${engine}" in
        aether)
            raw=$(extra_arg_value "--bind" ${args})
            ;;
        usque)
            raw=$(extra_arg_value "-p" ${args})
            [ -n "${raw}" ] || raw=$(extra_arg_value "--port" ${args})
            ;;
        warpscout)
            # -p 是协议 (masque), 监听端口用 -P / -port / --port
            raw=$(extra_arg_value "-P" ${args})
            [ -n "${raw}" ] || raw=$(extra_arg_value "-port" ${args})
            [ -n "${raw}" ] || raw=$(extra_arg_value "--port" ${args})
            ;;
    esac
    port="${raw##*:}"
    case "${port}" in
        ''|*[!0-9]*) port="" ;;
    esac

    file="${box_path}/clash/proxies/外部引擎.yaml"
    mkdir -p "${box_path}/clash/proxies" 2>/dev/null
    old=$(cat "${file}" 2>/dev/null)

    # 文件缺失或仍是旧版的 "socks5://host:port" 单行 → 重建为合法 provider;
    # 已是 provider 文件时只改本引擎条目 (name: "外部引擎") 的端口, 订阅内容原样保留
    new=$(printf '%s\n' "${old}" | awk -v port="${port}" -v def="${default_port}" -v add="${engine}" '
        /^[[:space:]]*proxies:[[:space:]]*\[\][[:space:]]*$/ { has = 0; empty = 1 }
        /^[[:space:]]*proxies:/ { if (!empty) has = 1 }
        !nidx && /^[[:space:]]*-[[:space:]]*name:[[:space:]]*"外部引擎"/ { nidx = NR }
        { line[NR] = $0 }
        END {
            if (!has) {
                printf "proxies:\n  - name: \"外部引擎\"\n    type: socks5\n    server: 127.0.0.1\n    port: %s\n    udp: true\n", (port != "" ? port : def)
                exit
            }
            if (!nidx) {
                if (add == "" || port == "") exit
                for (i = 1; i <= NR; i++) print line[i]
                printf "  - name: \"外部引擎\"\n    type: socks5\n    server: 127.0.0.1\n    port: %s\n    udp: true\n", port
                exit
            }
            if (port == "") exit
            done = 0
            for (i = 1; i <= NR; i++) {
                l = line[i]
                if (!done && i > nidx && l ~ /^[[:space:]]*port:[[:space:]]*[0-9]+/) {
                    sub(/port:[[:space:]]*[0-9]+/, "port: " port, l)
                    done = 1
                }
                print l
            }
        }
    ' 2>/dev/null)
    [ -n "${new}" ] || return 0
    [ "${new}" = "${old}" ] && return 0

    printf '%s\n' "${new}" > "${file}"
    if [ -n "${port}" ]; then
        extra_log Info "已同步引擎 SOCKS 端口 ${port} 到 ${file}"
    else
        extra_log Info "已重建 provider 文件 ${file}"
    fi
}

# clash 在引擎之前启动并读取 provider, 因此 box.service start 必须先修好该文件;
# 引擎启用且 cmdline 可读时顺带同步监听端口
extra_sync_cmdline_port() {
    local engine args=""
    engine=$(extra_engine) || engine=""
    if [ -n "${engine}" ]; then
        extra_paths "${engine}"
        args=$(extra_read_cmdline "${extra_cmdline}" 2>/dev/null) || args=""
    fi
    extra_sync_proxy_port "${engine}" "${args}"
}

extra_is_running() {
    local pid
    [ -f "${extra_pid_file}" ] || return 1
    pid=$(sed -n '1p' "${extra_pid_file}" 2>/dev/null | tr -d ' \t\r')
    # 空内容多半是写入中的瞬时状态, 不能当成脏数据删掉;
    # 判断只看进程是否还在, 读到空就等下一轮 probe
    [ -n "${pid}" ] || return 1
    case "${pid}" in
        *[!0-9]*) rm -f "${extra_pid_file}"; return 1 ;;
    esac
    extra_alive "${pid}" || { rm -f "${extra_pid_file}"; return 1; }
    extra_pid_matches "${pid}" "${extra_engine_name}" || { rm -f "${extra_pid_file}"; return 1; }
    return 0
}

extra_worker_running() {
    local pid
    [ -f "${extra_worker_pid_file}" ] || return 1
    pid=$(sed -n '1p' "${extra_worker_pid_file}" 2>/dev/null | tr -d ' \t\r')
    [ -n "${pid}" ] || return 1
    case "${pid}" in
        *[!0-9]*) rm -f "${extra_worker_pid_file}"; return 1 ;;
    esac
    extra_alive "${pid}" || { rm -f "${extra_worker_pid_file}"; return 1; }
    # worker 的 pid 可能是被复用的无关进程, 只认启动它的 box.service shell;
    # 状态文件必须同时存在, 否则界面会一直停在"正在初始化"
    extra_pid_matches "${pid}" "box.service" || { rm -f "${extra_worker_pid_file}"; return 1; }
    [ -f "${extra_state_file}" ] || { rm -f "${extra_worker_pid_file}"; return 1; }
    return 0
}

extra_worker() {
    local engine="$1" dir="$2" args generated pid rc version
    # 退出时清掉自己的 pid 与状态, 否则残留文件在 PID 复用后会让界面一直显示正在初始化
    trap 'rm -f "${extra_worker_pid_file}" "${extra_state_file}"' EXIT
    extra_log Info "外部引擎 ${engine} 初始化开始"
    extra_log Info "日志文件: ${extra_run_log}"
    extra_log Info "引擎输出: ${extra_out_log}"
    extra_log Info "工作目录: ${dir}, 运行用户组: ${box_user_group}"
    extra_wait_network || extra_log Warn "网络尚未就绪, 继续尝试初始化"

    rm -f "${dir}"/.download.* 2>/dev/null

    if [ -f "${dir}/${engine}" ] && [ ! -x "${dir}/${engine}" ]; then
        chmod 0755 "${dir}/${engine}" 2>/dev/null
    fi
    if [ ! -x "${dir}/${engine}" ]; then
        extra_log Info "未检测到可执行二进制, 开始下载安装..."
        extra_install_bin "${engine}" "${dir}" || {
            extra_log Error "${engine} 下载/安装失败"
            return 1
        }
    fi
    version=$(sed -n '1p' "${dir}/version" 2>/dev/null | tr -d ' \t\r')
    [ -n "${version}" ] || version="未知"
    extra_log Info "二进制: ${extra_bin} (版本: ${version})"

    extra_init_conf "${engine}" "${dir}" || {
        extra_log Error "${engine} 初始化配置失败"
        extra_log_tail 15
        return 1
    }

    generated=0
    args=$(extra_read_cmdline "${extra_cmdline}")
    if [ -z "${args}" ]; then
        extra_log Info "未找到 cmdline, 使用默认参数"
        args=$(extra_default_cmdline "${engine}") || return 1
        generated=1
    fi

    extra_sync_proxy_port "${engine}" "${args}"

    extra_log Info "启动命令: ${engine} ${args}"
    cd "${dir}" || return 1
    # 与 clash 同用户组启动: box.iptables 在 BOX_LOCAL/CLASH_DNS_LOCAL 首条按 uid+gid 放行,
    # 引擎自身的出站流量因此同样绕过透明代理, 不会被 TPROXY 回环劫持
    setuidgid "${box_user_group}" "${extra_bin}" ${args} < /dev/null >> "${extra_out_log}" 2>&1 &
    pid=$!
    extra_write_pid "${extra_pid_file}" "${pid}"
    extra_log Info "已拉起进程 (PID: ${pid}), 等待 3 秒确认存活..."

    sleep 3
    if ! extra_alive "${pid}"; then
        wait "${pid}" 2>/dev/null
        rc=$?
        rm -f "${extra_pid_file}"
        if [ -s "${extra_out_log}" ]; then
            extra_log Info "----- 引擎输出最近 20 行 -----"
            extra_log_tail 20
        fi
        extra_log Error "${engine} 启动失败 (退出码: ${rc})"
        return 1
    fi

    if [ "${generated}" = "1" ] && [ ! -f "${extra_cmdline}" ]; then
        printf '%s\n' "${args}" > "${extra_cmdline}"
        extra_log Info "启动成功, 默认参数已写入 ${extra_cmdline}"
    fi
    extra_log Info "${engine} 已启动 (PID: ${pid})"
    # probe 以状态文件判定真实阶段: 初始化结束即改 running, 不再靠输入输出猜
    printf 'running %s\n' "${pid}" > "${extra_state_file}" 2>/dev/null

    # clash 启动失败时不做联动, 避免引擎被误杀
    if extra_clash_alive; then
        extra_log Info "开始监听 ${bin_name} 存活状态"
        extra_clash_guard "${pid}"
    else
        extra_log Warn "${bin_name} 未运行, 不做联动"
    fi

    wait "${pid}" 2>/dev/null
    rc=$?
    extra_log Warn "${engine} 已退出 (PID: ${pid}, 退出码: ${rc})"
    if [ -s "${extra_out_log}" ]; then
        extra_log Info "----- 引擎输出最近 15 行 -----"
        extra_log_tail 15
    fi
    rm -f "${extra_pid_file}"
}

extra_start() {
    local engine
    engine=$(extra_engine) || {
        extra_log Info "外部引擎未启用 (${extra_engine_file} 为 clash/mihomo 或缺失)"
        return 0
    }
    extra_paths "${engine}"
    mkdir -p "${run_path}" "${extra_log_dir}" 2>/dev/null

    if extra_is_running; then
        extra_log Info "${engine} 已在运行 (PID: $(cat "${extra_pid_file}"))"
        return 0
    fi
    if extra_worker_running; then
        extra_log Info "${engine} 正在初始化 (PID: $(cat "${extra_worker_pid_file}"))"
        return 0
    fi

    printf 'initializing\n' > "${extra_state_file}" 2>/dev/null
    ( extra_worker "${engine}" "${extra_dir}" ) >> "${extra_run_log}" 2>&1 &
    extra_write_pid "${extra_worker_pid_file}" "$!"
    # 没拿到 worker pid 时状态无从核对, 留着 initializing 会让界面永久停在初始化
    [ -s "${extra_worker_pid_file}" ] || rm -f "${extra_state_file}"
    extra_log Info "外部引擎 ${engine} 已转入后台启动, 日志: ${extra_run_log}"
}

extra_stop() {
    local engine pid pid_file
    engine=$(extra_engine) || return 0
    extra_paths "${engine}"

    for pid_file in "${extra_pid_file}" "${extra_worker_pid_file}"; do
        [ -f "${pid_file}" ] || continue
        pid=$(cat "${pid_file}" 2>/dev/null)
        case "${pid}" in
            ''|*[!0-9]*) rm -f "${pid_file}"; continue ;;
        esac
        if kill -0 "${pid}" 2>/dev/null; then
            extra_log Warn "正在停止 ${engine} (PID: ${pid})"
            kill "${pid}" 2>/dev/null
        fi
        rm -f "${pid_file}"
    done

    sleep 1
    pkill -9 -f "${extra_dir}/.download" 2>/dev/null
    pkill -9 -f "${extra_bin}" 2>/dev/null
    rm -f "${extra_state_file}"
}

# 改写 engine= 行; 旧格式或文件缺失时重建为带可选清单的文件
extra_write_engine() {
    local name="$1" tmp="${extra_engine_file}.tmp"
    mkdir -p "${extra_path}" 2>/dev/null
    if [ -f "${extra_engine_file}" ] && grep -q '^[[:space:]]*engine=' "${extra_engine_file}"; then
        sed "s@^\([[:space:]]*\)engine=.*@\1engine=${name}@" \
            "${extra_engine_file}" > "${tmp}" && mv -f "${tmp}" "${extra_engine_file}"
    else
        printf '%s\n' \
            '# 外部引擎开关: 只保留一个 engine= 行生效, 改等号后的名字即可切换' \
            '# 可选 aether / usque / warpscout, 改为 none 表示不启用' \
            "engine=${name}" > "${extra_engine_file}"
    fi
}

# 按字母顺序轮换: aether -> usque -> warpscout -> aether, 未启用时从 aether 开始
extra_switch() {
    local current next
    current=$(extra_engine) || current=""
    case "${current}" in
        aether) next="usque" ;;
        usque) next="warpscout" ;;
        *) next="aether" ;;
    esac

    if [ -n "${current}" ]; then
        extra_paths "${current}"
        if extra_is_running || extra_worker_running; then
            extra_stop
        fi
    fi

    extra_write_engine "${next}"
    printf '外部引擎: %s -> %s\n' "${current:-未启用}" "${next}"

    if extra_clash_alive; then
        extra_sync_cmdline_port
        extra_start
    else
        printf 'clash 未运行, 下次启动时使用 %s\n' "${next}"
    fi
}

# 未安装则下载; 已安装则比对本地 version 与最新 release tag, 仅在版本变化时下载
extra_update() {
    local engine latest current was_running=0

    engine=$(extra_engine) || {
        extra_log Warn "外部引擎未启用 (${extra_engine_file} 为 clash/mihomo 或缺失)"
        return 1
    }
    extra_paths "${engine}"
    mkdir -p "${extra_dir}" "${extra_log_dir}" 2>/dev/null

    extra_log Info "正在检查 ${engine} 最新版本..."
    latest=$(extra_remote_tag "${engine}") || {
        extra_log Error "获取 ${engine} 最新版本失败 (GitHub 直连与镜像均不可用)"
        return 1
    }
    latest=$(printf '%s' "${latest}" | tr -d ' \t\r')
    if [ -z "${latest}" ]; then
        extra_log Error "未解析到 ${engine} 最新版本号"
        return 1
    fi

    current=$(extra_local_version) || current=""
    if extra_bin_installed && [ -n "${current}" ] && [ "${current}" = "${latest}" ]; then
        extra_log Info "已是最新版本 ${latest}, 无需更新"
        return 0
    fi

    if extra_bin_installed; then
        if [ -n "${current}" ]; then
            extra_log Info "发现新版本: ${current} -> ${latest}"
        else
            extra_log Info "本地二进制无版本记录, 重新安装 ${latest}"
        fi
    else
        extra_log Info "未检测到 ${engine} 二进制, 准备安装 ${latest}"
    fi

    if extra_is_running || extra_worker_running; then
        was_running=1
        extra_stop
    fi

    if ! extra_install_bin "${engine}" "${extra_dir}"; then
        extra_log Error "${engine} 下载/安装失败, 请查看日志: ${extra_run_log}"
        return 1
    fi

    if [ "${was_running}" = "1" ]; then
        extra_log Info "正在重新启动 ${engine}..."
        extra_start
    fi
    return 0
}

extra_run_time() {
    /system/bin/ps -eo etime,comm 2>/dev/null | awk -v bin="${extra_engine_name}" '$2 == bin { print $1; exit }'
}

extra_status() {
    local engine args state_stage state_pid
    engine=$(extra_engine) || {
        extra_log Info "外部引擎: 未启用"
        return 0
    }
    extra_paths "${engine}"
    state_stage=$(extra_state_stage)
    state_pid=$(extra_state_pid)

    extra_log Info "外部引擎: ${engine}"
    if extra_bin_installed; then
        if [ -f "${extra_dir}/version" ]; then
            extra_log Info "二进制版本: $(cat "${extra_dir}/version" 2>/dev/null)"
        else
            extra_log Info "二进制: ${extra_bin}"
        fi
    else
        extra_log Warn "二进制未安装: ${extra_bin}"
    fi

    args=$(extra_read_cmdline "${extra_cmdline}")
    if [ -n "${args}" ]; then
        extra_log Info "启动参数: ${args}"
    else
        extra_log Info "启动参数: 尚未生成 (首次启动成功后写入 ${extra_cmdline})"
    fi

    if extra_is_running; then
        extra_log Info "${engine} 运行中 (PID: $(sed -n '1p' "${extra_pid_file}" 2>/dev/null | tr -d ' \t\r'))"
        extra_log Info "${engine} 运行时长: $(extra_run_time)"
    elif [ -n "${state_pid}" ] && extra_alive "${state_pid}"; then
        extra_log Info "${engine} 运行中 (PID: ${state_pid})"
        extra_log Info "${engine} 运行时长: $(extra_run_time)"
    elif [ "${state_stage}" = "initializing" ] && extra_worker_running; then
        extra_log Info "${engine} 正在初始化 (PID: $(sed -n '1p' "${extra_worker_pid_file}" 2>/dev/null | tr -d ' \t\r'))"
    else
        extra_log Warn "${engine} 未运行"
    fi
    return 0
}

# 供 WebUI 状态页读取, 只输出 key=value, 不写日志
extra_probe() {
    local engine pid version state_stage state_pid

    engine=$(extra_engine) || {
        printf 'engine=clash\n'
        printf 'engine_state=disabled\n'
        return 0
    }
    extra_paths "${engine}"
    state_stage=$(extra_state_stage)
    state_pid=$(extra_state_pid)
    printf 'engine=%s\n' "${engine}"
    version=$(extra_local_version) || version=""
    [ -n "${version}" ] && printf 'engine_version=%s\n' "${version}"

    if extra_is_running; then
        pid=$(sed -n '1p' "${extra_pid_file}" 2>/dev/null | tr -d ' \t\r')
        printf 'engine_state=running\n'
        printf 'engine_pid=%s\n' "${pid}"
        printf 'engine_etime=%s\n' "$(extra_run_time)"
    elif [ -n "${state_pid}" ] && extra_alive "${state_pid}"; then
        # pid 文件缺失/损坏时按状态文件恢复, 避免引擎在跑却显示别的状态
        extra_write_pid "${extra_pid_file}" "${state_pid}"
        printf 'engine_state=running\n'
        printf 'engine_pid=%s\n' "${state_pid}"
        printf 'engine_etime=%s\n' "$(extra_run_time)"
    elif [ "${state_stage}" = "initializing" ] && extra_worker_running; then
        printf 'engine_state=initializing\n'
        printf 'engine_pid=%s\n' "$(sed -n '1p' "${extra_worker_pid_file}" 2>/dev/null | tr -d ' \t\r')"
    elif extra_bin_installed; then
        printf 'engine_state=stopped\n'
    else
        printf 'engine_state=missing\n'
    fi
    return 0
}
