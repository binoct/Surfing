#!/system/bin/sh
export PATH="/data/adb/box_bll/bin:$PATH"

SYS_IP="/system/bin/ip"
SYS_IPTABLES="/system/bin/iptables"
SYS_IP6TABLES="/system/bin/ip6tables"

scripts=$(realpath "$0")
scripts_dir=$(dirname "${scripts}")

. "${scripts_dir}/box.config"

# probe 被 WebUI 每 5 秒轮询, extra-log 用于即时排障, 均跳过目录清理
case "$1" in
    probe|extra-log) ;;
    *)
        {
            mkdir -p "${run_path}"
            mkdir -p "${box_path}/${bin_name}/log"
            find "${box_path}" -mtime +3 -type f -name "*.log" -exec rm -f {} +
        } >/dev/null 2>&1
        ;;
esac

log() {
    TZ=Asia/Shanghai
    now=$(date +"[%Y-%m-%d %H:%M:%S %Z]")
    case "$1" in
        Info)
            [ -t 1 ] && printf "\033[1;32m%s [Info]: %s\033[0m\n" "${now}" "$2" || echo "${now} [Info]: $2"
            ;;
        Warn)
            [ -t 1 ] && printf "\033[1;33m%s [Warn]: %s\033[0m\n" "${now}" "$2" || echo "${now} [Warn]: $2"
            ;;
        Error)
            [ -t 1 ] && printf "\033[1;31m%s [Error]: %s\033[0m\n" "${now}" "$2" || echo "${now} [Error]: $2"
            ;;
        *)
            [ -t 1 ] && printf "\033[1;30m%s [%s]: %s\033[0m\n" "${now}" "$1" "$2" || echo "${now} [$1]: $2"
            ;;
    esac
}

[ -f "${scripts_dir}/box.extra" ] && . "${scripts_dir}/box.extra"

get_bin_pid() {
    pidof -s "${bin_name}"
}

get_bin_etime() {
    /system/bin/ps -eo etime,comm | awk -v bin="${bin_name}" '$2 == bin { print $1; exit }'
}

check_permission() {
    bin_path=$(command -v "${bin_name}" 2>/dev/null)
    [ -z "${bin_path}" ] && bin_path="${box_path}/bin/${bin_name}"

    eval $(echo "${box_user_group}" | awk -F ':' '{ print "box_user=" $1 ";box_group=" $2 }')

    {
        chown "${box_user_group}" "${bin_path}"
        chmod 0755 "${bin_path}"
        chown -R "${box_user_group}" "${box_path}/${bin_name}"
    } >/dev/null 2>&1
    return 0
}

start_bin() {
    ulimit -SHn 1000000

    if [ "${bin_name}" != "clash" ] && [ "${bin_name}" != "mihomo" ]; then
        log Error "配置冲突: 仅支持 clash/mihomo 核心, 当前核心为 ${bin_name}."
        return 2
    fi

    local check_args="-t -d ${box_path}/${bin_name}"
    local run_args="-d ${box_path}/${bin_name}"
    local log_out="${box_path}/${bin_name}/log/${bin_name}_$(date +%Y%m%d%H%M).log"

    if ${bin_path} ${check_args} > "${run_path}/check.log" 2>&1; then
        log Info "配置校验通过: 正在启动 ${bin_name} 核心进程."
        setuidgid "${box_user_group}" "${bin_path}" ${run_args} > "${log_out}" 2> "${run_path}/error_${bin_name}.log" &
        printf "%s" "$!" > "${pid_file}"
        return 0
    fi

    log Error "配置校验失败: 请检查 ${run_path}/check.log 中的语法错误."
    if [ -s "${run_path}/check.log" ]; then
        log Error "----- 校验输出 -----"
        sed -n '1,40p' "${run_path}/check.log"
    fi
    return 1
}

wait_bin_listen() {
    local wait_count=0
    local max_wait=3

    while [ "${wait_count}" -lt "${max_wait}" ]; do
        bin_pid=$(get_bin_pid)
        if [ -n "${bin_pid}" ]; then
            if ls -l "/proc/${bin_pid}/fd" 2>/dev/null | awk '/socket:/{ f=1; exit } END{ exit !f }'; then
                log Info "${bin_name} 核心网络套接字已成功绑定并就绪."
                return 0
            fi
        fi
        sleep 1
        wait_count=$((wait_count + 1))
    done

    log Error "${bin_name} 核心响应超时，请检查 ${run_path}/error_${bin_name}.log."
    return 1
}

display_run_time() {
    /system/bin/ps -eo etime,comm | awk -v bin="${bin_name}" '
        $2 == bin {
            t = $1
            if (t ~ /-/) {
                split(t, d, "-")
                split(d[2], tm, ":")
                print d[1] "天" tm[1] "时" tm[2] "分"
                exit
            }
            n = split(t, tm, ":")
            if (n == 3) { print tm[1] "时" tm[2] "分"; exit }
            if (n == 2) { print tm[1] "分钟"; exit }
        }'
}

display_bin_status() {
    bin_pid=$(get_bin_pid)
    if [ -z "${bin_pid}" ]; then
        log Warn "进程确认: ${bin_name} 服务当前已处于停止状态."
        return 1
    fi

    log Info "${bin_name} 当前上下文 (UID:GID): $(stat -c %U:%G /proc/${bin_pid})."
    log Info "${bin_name} 当前活跃进程 (PID: ${bin_pid})."

    mem_mb=$(awk '/VmRSS/ { printf "%.2f MB", $2/1024; exit }' /proc/${bin_pid}/status)
    log Info "${bin_name} 物理内存占用: ${mem_mb}"

    cpu_usage=$(/system/bin/ps -eo %CPU,NAME 2>/dev/null | awk -v bin="${bin_name}" '$2 == bin { print $1 "%"; exit }')
    if [ -z "${cpu_usage}" ] || [ "${cpu_usage}" = "0%" ]; then
        cpu_usage=$(dumpsys cpuinfo | awk -v bin="${bin_name}" '$0 ~ bin { print $1; exit }')
    fi
    log Info "${bin_name} CPU 资源占用: ${cpu_usage}"
    log Info "${bin_name} 进程持续运行时间: $(display_run_time)"

    printf "%s" "${bin_pid}" > "${pid_file}"
    return 0
}

# 启动互斥: 用锁目录取代 pgrep -f, 后者会把包含 "box.service start" 的调用方 shell
# (如 WebUI 的 sh -c 命令) 误判为已有实例, 导致启动被直接放弃
acquire_start_lock() {
    local lock="${run_path}/.start.lock" pid
    if mkdir -p "${run_path}" 2>/dev/null && mkdir "${lock}" 2>/dev/null; then
        printf '%s' "$$" > "${lock}/pid"
        trap "rm -rf '${lock}'" EXIT
        return 0
    fi
    pid=$(cat "${lock}/pid" 2>/dev/null)
    if [ -n "${pid}" ] && extra_alive "${pid}"; then
        log Warn "环境检查: 已有启动流程在执行 (PID: ${pid}), 本次已自动挂起."
        return 1
    fi
    rm -rf "${lock}"
    if mkdir "${lock}" 2>/dev/null; then
        printf '%s' "$$" > "${lock}/pid"
        trap "rm -rf '${lock}'" EXIT
        return 0
    fi
    log Warn "环境检查: 启动锁竞争失败, 本次已自动挂起."
    return 1
}

clear_port_blockers() {
    local check_ports="${redir_port} ${tproxy_port} ${clash_dns_port} 7890"
    local ss_cache=$(/system/bin/ss -tulnp 2>/dev/null)
    local port
    local occupier_pid
    local occupier_name

    for port in ${check_ports}; do
        [ -z "${port}" ] && continue
        occupier_pid=$(echo "${ss_cache}" | awk -v p=":${port} " '$0 ~ p && /pid=/ { match($0, /pid=[0-9]+/); print substr($0, RSTART+4, RLENGTH-4); exit }')

        if [ -n "${occupier_pid}" ]; then
            occupier_name=$(cat /proc/${occupier_pid}/comm 2>/dev/null || echo "未知进程")
            log Warn "端口 ${port} 被 [${occupier_name}] (PID: ${occupier_pid}) 占用，已强制 kill."
            kill -9 "${occupier_pid}" 2>/dev/null
            sleep 0.5
        fi
    done
}

start_service() {
    if check_permission; then
        log Info "正在授权核心以 ${box_user_group} 用户组身份启动."
        clear_port_blockers

        if start_bin; then
            log Info "${bin_name} 核心已准备就绪 (PID: $(cat "${pid_file}"))."
            return 0
        fi

        log Error "核心进程异常，启动流程已终止."
        rm -f "${pid_file}" >/dev/null 2>&1
        return 1
    fi

    log Error "二进制核心缺失: 请将 ${bin_name} 放置于 ${box_path}/bin/ 目录."
    return 2
}

stop_service() {
    if display_bin_status; then
        log Warn "正在下发 SIGTERM 终止 ${bin_name} 进程."
        kill "$(cat "${pid_file}")" 2>/dev/null || killall "${bin_name}"
        sleep 1
        display_bin_status
    fi
    rm -f "${pid_file}" >/dev/null 2>&1
}

case "$1" in
    start)
        extra_sync_cmdline_port
        bin_pid=$(get_bin_pid)
        if [ -n "${bin_pid}" ]; then
            log Info "${bin_name} 核心已在后台稳健运行 (PID: ${bin_pid})."
            extra_start
            exit 0
        fi

        acquire_start_lock || exit 0

        log Info "开始执行核心服务启动序列 (主控 PID: $$)."
        if ! start_service; then
            log Error "核心启动失败, 已跳过外部引擎启动."
            exit 1
        fi
        uptime_sec=$(cut -d. -f1 /proc/uptime)
        [ "${uptime_sec%.*}" -lt 180 ] && log Info "检测到系统冷启动，正在同步运行环境." && sleep 5
        wait_bin_listen || true
        extra_start
        ;;
    stop)
        stop_service
        extra_stop
        "${scripts_dir}/box.iptables" tun_forward_disable
        ;;
    restart)
        log Warn "正在执行服务热重启操作."
        $0 stop
        sleep 2
        $0 start
        ;;
    status)
        display_bin_status
        extra_status
        ;;
    probe)
        bin_pid=$(get_bin_pid)
        if [ -n "${bin_pid}" ]; then
            printf 'clash_state=running\n'
            printf 'clash_pid=%s\n' "${bin_pid}"
            et=$(/system/bin/ps -eo etime,comm 2>/dev/null | awk -v b="${bin_name}" '$2==b{print $1;exit}')
            [ -n "${et}" ] && printf 'clash_etime=%s\n' "${et}"
        else
            printf 'clash_state=stopped\n'
        fi
        extra_probe
        ;;
    extra-log)
        engine=$(extra_engine) || {
            echo "外部引擎: 未启用 (${extra_engine_file} 为 clash/mihomo 或缺失)"
            exit 0
        }
        extra_paths "${engine}"
        n="$2"
        case "${n}" in
            ''|*[!0-9]*) n=40 ;;
        esac
        echo "引擎: ${engine}"
        if [ -f "${extra_dir}/version" ]; then
            echo "版本: $(sed -n '1p' "${extra_dir}/version" 2>/dev/null)"
        else
            echo "版本: 未知"
        fi
        if [ -x "${extra_bin}" ]; then
            echo "二进制: ${extra_bin}"
        else
            echo "二进制: ${extra_bin} (不存在)"
        fi
        args=$(extra_read_cmdline "${extra_cmdline}")
        if [ -n "${args}" ]; then
            echo "启动参数: ${args}"
        else
            echo "启动参数: 尚未生成"
        fi
        bin_pid=$(get_bin_pid)
        if [ -n "${bin_pid}" ]; then
            echo "${bin_name}: 运行中 (PID: ${bin_pid})"
        else
            echo "${bin_name}: 已停止"
        fi
        if extra_is_running; then
            echo "引擎状态: 运行中 (PID: $(cat "${extra_pid_file}" 2>/dev/null))"
        elif extra_worker_running; then
            echo "引擎状态: 正在初始化 (PID: $(cat "${extra_worker_pid_file}" 2>/dev/null))"
        else
            echo "引擎状态: 未运行"
        fi
        echo "运行日志: ${extra_run_log}"
        echo "----- 运行日志最近 ${n} 行 -----"
        if [ -f "${extra_run_log}" ]; then
            tail -n "${n}" "${extra_run_log}" 2>/dev/null
        else
            echo "(暂无日志)"
        fi
        echo "引擎输出: ${extra_out_log}"
        if [ -s "${extra_out_log}" ]; then
            echo "----- 引擎输出最近 ${n} 行 -----"
            tail -n "${n}" "${extra_out_log}" 2>/dev/null
        else
            echo "(暂无输出)"
        fi
        ;;
    extra-update)
        extra_update
        ;;
    *)
        log Error "相关指令: $0 {start|stop|restart|status|probe|extra-log|extra-update}"
        exit 1
        ;;
esac
